#!/bin/bash
# =============================================================================
# .githooks/pre-commit — FAST quality + secret gate (runs on every commit)
# =============================================================================
# Stages, in order:
#   1. Ruff format + lint on staged .py files (auto-restages formatting fixes)
#   2. ESLint --fix on staged JS/TS files (auto-restages, blocks on errors)
#   3. Prettier --write on staged frontend files (auto-restages)
#   4. detect-secrets on STAGED files vs the baseline (new secrets only)
#
# Slow gates (pytest + coverage, full-tree secret scan, pip-audit) live in
# .githooks/pre-push so commits stay fast. Inactive stages (tool not
# installed) are skipped with a warning.
#
# First-time setup (after cloning):  make setup
#
# Exit codes:  0 = commit proceeds   1 = a check failed, commit blocked
# =============================================================================

REPO_ROOT="$(git rev-parse --show-toplevel)"
VENV_BIN="$REPO_ROOT/.venv/bin"

RUFF="$VENV_BIN/ruff"
BASELINE="$REPO_ROOT/.secrets.baseline"

# Same exclude list the baseline is generated with — keep these in sync.
# Migration IDs are high-entropy noise, not secrets (harmless if none exist).
SECRETS_EXCLUDE='(\.secrets\.baseline$|/versions/.*\.py$|^alembic/versions/)'

# -----------------------------------------------------------------------------
# Stage — Ruff format + lint on staged Python files
# -----------------------------------------------------------------------------

staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

if [ -n "$staged_py" ]; then
  if [ ! -x "$RUFF" ]; then
    echo "⚠  Ruff not found at $RUFF — is the venv set up? Run: make setup" >&2
  else
    echo "🎨 Ruff format on staged files..."
    # shellcheck disable=SC2086
    "$RUFF" format $staged_py --quiet
    # shellcheck disable=SC2086
    git add $staged_py

    echo "🔍 Ruff check on staged files..."
    # shellcheck disable=SC2086
    if ! "$RUFF" check $staged_py; then
      echo "" >&2
      echo "🚨 Ruff lint errors found. Commit blocked." >&2
      echo "   Fix the issues above, then re-stage and re-commit." >&2
      exit 1
    fi
  fi
fi

# -----------------------------------------------------------------------------
# Stage — ESLint fix + lint on staged JS/TS files
# -----------------------------------------------------------------------------

staged_js=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|jsx|tsx|vue)$' || true)

if [ -n "$staged_js" ]; then
  if ! command -v eslint &>/dev/null; then
    echo "⚠  eslint not found on PATH — skipping JS/TS lint." >&2
  else
    echo "🔧 ESLint --fix on staged files..."
    # shellcheck disable=SC2086
    eslint --fix $staged_js 2>/dev/null; eslint_exit=$?
    # shellcheck disable=SC2086
    git add $staged_js

    if [ $eslint_exit -ne 0 ]; then
      echo "" >&2
      echo "🚨 ESLint errors remain after auto-fix. Commit blocked." >&2
      echo "   Fix the issues above, then re-stage and re-commit." >&2
      exit 1
    fi
  fi
fi

# -----------------------------------------------------------------------------
# Stage — Prettier format on staged frontend files
# -----------------------------------------------------------------------------

staged_fmt=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|jsx|tsx|vue|css|scss|html|json|md)$' || true)

if [ -n "$staged_fmt" ]; then
  if ! command -v prettier &>/dev/null; then
    echo "⚠  prettier not found on PATH — skipping format." >&2
  else
    echo "✨ Prettier --write on staged files..."
    # shellcheck disable=SC2086
    prettier --write $staged_fmt --log-level warn
    # shellcheck disable=SC2086
    git add $staged_fmt
  fi
fi

# -----------------------------------------------------------------------------
# Stage — detect-secrets on STAGED files only
# -----------------------------------------------------------------------------
# detect-secrets-hook is the tool's purpose-built pre-commit entry point: it
# checks only this commit's files and fails only on a secret NOT already in
# the baseline. The old whole-tree exact-match compare blocked every commit
# whenever the baseline drifted anywhere — even for unrelated files — and
# flagged known secrets as "new" just because code moved lines.
# The full-tree check still happens, once per push, in .githooks/pre-push.

# Locate detect-secrets-hook: venv first, then PATH
DS_HOOK="$VENV_BIN/detect-secrets-hook"
[ -x "$DS_HOOK" ] || DS_HOOK="$(command -v detect-secrets-hook 2>/dev/null || true)"

if [ -z "$DS_HOOK" ]; then
  echo "⚠  detect-secrets-hook not found — secret scanning skipped." >&2
  echo "⚠  Install with: pip install detect-secrets" >&2
  exit 0
fi

if [ ! -f "$BASELINE" ]; then
  echo "⚠  No .secrets.baseline — run: detect-secrets scan --exclude-files '$SECRETS_EXCLUDE' > .secrets.baseline" >&2
  exit 0
fi

# Nothing staged (e.g. --allow-empty) means nothing to scan
if [ -z "$(git diff --cached --name-only --diff-filter=ACM)" ]; then
  exit 0
fi

echo "🔐 Scanning staged files for secrets..."

# -z / -0 keeps filenames containing spaces intact
if ! git diff --cached --name-only --diff-filter=ACM -z \
  | xargs -0 "$DS_HOOK" --baseline "$BASELINE" --exclude-files "$SECRETS_EXCLUDE"; then
  echo "" >&2
  echo "🚨 Commit blocked by secret scan. Either:" >&2
  echo "   • a NEW secret is staged → remove it, re-stage, re-commit; or" >&2
  echo "   • it's a false positive → add  # pragma: allowlist secret  on that line; or" >&2
  echo "   • the hook refreshed baseline line numbers → git add .secrets.baseline, re-commit" >&2
  exit 1
fi

echo "✔  No new secrets in staged files."
exit 0
