# Prettier ignore - generated and non-source files
.venv/
node_modules/
__pycache__/
dist/
build/
*.egg-info/
coverage/
.coverage

# YAML forbids tabs, and .prettierrc sets useTabs — never let prettier near this.
docker-compose.yml

# Jinja templates: Prettier parses them as plain HTML and rewraps {{ }} and
# {% %} across lines, which changes the rendered text.
web/templates/

# Hand-wrapped Markdown: Prettier's reflow pulls continuation lines out of
# nested list items.
*.md
