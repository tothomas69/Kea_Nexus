# ─── Kea direct API (shared with KeaNexus) ───────────────────────────────────
KEA_API_URL=http://localhost:8004
KEA_API_USER=
KEA_API_PASSWORD=

# ─── ARP disruption ────────────────────────────────────────────────────
# Network interface scapy sends spoofed ARP replies on. Leave blank to let
# scapy auto-select the default route interface — set explicitly if this
# host is multi-homed, since guessing wrong means either silent no-op or
# poisoning the wrong segment. Find it with: ip route get 172.16.17.1
ARP_INTERFACE=

# ─── Pi-hole v6 API ─────────────────────────────────────────────────
# Base URL, no trailing /api — the client appends that itself.
PIHOLE_API_URL=http://172.16.17.212
# Admin password, or an application password generated on the Pi-hole
# settings page if you'd rather not put the real password in this file.
PIHOLE_API_PASSWORD=

# Optional secondary Pi-hole instance. The two Pi-hole instances on this
# network are fully independent — no Nebula/Gravity/Orbital Sync between
# them — so a device blocked only on the primary could still resolve DNS
# through the secondary if it's ever used as a fallback resolver. Leave
# blank to skip writing the block to a secondary instance entirely.
PIHOLE_SECONDARY_API_URL=
PIHOLE_SECONDARY_API_PASSWORD=

# ─── Quarantine service auth ─────────────────────────────────────────────────
# Bearer token required on every request. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Store the same value in whatever calls this API (Siri Shortcut, etc).
# Never commit the real value — this file is the template only.
QUARANTINE_API_TOKEN=
