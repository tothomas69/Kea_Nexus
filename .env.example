# ─── Kea direct API (Kea 3.0+) ───────────────────────────────────────────────
# Point at the kea-dhcp4 HTTP listener (conventionally port 8004).
# Leave KEA_API_USER / KEA_API_PASSWORD blank if no auth is configured
# on the listener (acceptable on a trusted LAN).
KEA_API_URL=http://localhost:8004
KEA_API_USER=
KEA_API_PASSWORD=

# ─── KeaNexus login ──────────────────────────────────────────────────────────
# Creates the first admin account the first time KeaNexus starts with an empty
# users table. After that, users are managed in Settings → Users, and changing
# these two values has no effect.
KEANEXUS_USERNAME=admin
KEANEXUS_PASSWORD=changeme
# Signs the login cookie so a session survives a page reload. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, logins still work but every reload asks you to sign in again.
# Changing it signs everyone out.
KEANEXUS_SECRET=

# ─── "Check who's online" (ARP sweep) ─────────────────────────────────────────
# Optional. The background sweep runs every LIVENESS_SWEEP_INTERVAL_SECONDS
# (default 300, minimum 30). Set KEANEXUS_WEB_LIVENESS_SWEEP=off where the
# container has no host networking / NET_RAW (a laptop dev run). ARP_INTERFACE
# pins the sweep to one interface when the host has several.
# LIVENESS_SWEEP_INTERVAL_SECONDS=300
# KEANEXUS_WEB_LIVENESS_SWEEP=on
# ARP_INTERFACE=eth0

# ─── Pi-hole health dots (header) ────────────────────────────────────────────
# Optional. Each URL set here adds a dot that turns green when that Pi-hole
# answers HTTP. No password: the check never signs in. Include the admin page's
# port (8080 here), or the check knocks on port 80 and reads the Pi-hole as down.
PIHOLE_API_URL=http://172.16.17.212:8080
PIHOLE_SECONDARY_API_URL=

# ─── Pool utilisation history (Dashboard trend chart) ────────────────────────
# Kea keeps no history of its own, so KeaNexus samples its pool counters into
# SQLite on a loop. Both are optional — the defaults below are used if unset.
# Interval is floored at 1 second. Retention prunes older samples on each pass;
# at the default interval that is roughly 8,600 rows per 30 days.
POOL_SAMPLE_INTERVAL_SECONDS=300
POOL_SAMPLE_RETENTION_DAYS=30
