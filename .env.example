# ─── Kea direct API (Kea 3.0+) ───────────────────────────────────────────────
# Point at the kea-dhcp4 HTTP listener (conventionally port 8004).
# Leave KEA_API_USER / KEA_API_PASSWORD blank if no auth is configured
# on the listener (acceptable on a trusted LAN).
KEA_API_URL=http://localhost:8004
KEA_API_USER=
KEA_API_PASSWORD=

# ─── KeaNexus login ──────────────────────────────────────────────────────────
KEANEXUS_USERNAME=admin
KEANEXUS_PASSWORD=changeme

# ─── keanexus-quarantine (Quarantine tab's Quarantine/Release buttons) ───────
# Base URL of the keanexus-quarantine service. Must be the Docker host's real
# LAN IP, NOT localhost or 127.0.0.1 — keanexus-quarantine runs with
# network_mode: host while KeaNexus itself is on the default bridge network,
# so "localhost" from inside the KeaNexus container means its own network
# namespace, not the Docker host. Find the host's LAN IP with: ip addr
QUARANTINE_SERVICE_URL=http://<netstack-lan-ip>:8600
# Must exactly match QUARANTINE_API_TOKEN in quarantine_service/.env.
QUARANTINE_SERVICE_TOKEN=
